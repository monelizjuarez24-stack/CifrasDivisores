<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.cifrasdivisores.PrimaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Ingrese un número" />
                <TextField fx:id="txtNumero" prefWidth="120.0" />
                <Button text="Analizar" onAction="#analizarNumero" />
                <Button text="Limpiar" onAction="#limpiarCampos" />
            </children>
        </HBox>

        <HBox spacing="40.0" alignment="CENTER_LEFT">
            <children>
                <VBox spacing="10.0">
                    <children>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Cantidad de cifras" prefWidth="140.0"/>
                            <TextField fx:id="txtCantCifras" editable="false" prefWidth="100.0"/>
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Suma de cifras impares" prefWidth="140.0"/>
                            <TextField fx:id="txtSumaImpares" editable="false" prefWidth="100.0"/>
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Suma de cifras pares" prefWidth="140.0"/>
                            <TextField fx:id="txtSumaPares" editable="false" prefWidth="100.0"/>
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Suma total de cifras" prefWidth="140.0"/>
                            <TextField fx:id="txtSumaTotal" editable="false" prefWidth="100.0"/>
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Cifra mayor" prefWidth="140.0"/>
                            <TextField fx:id="txtMayor" editable="false" prefWidth="100.0"/>
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Cifra menor" prefWidth="140.0"/>
                            <TextField fx:id="txtMenor" editable="false" prefWidth="100.0"/>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="10.0">
                    <children>
                        <Label text="Divisores" />
                        <ListView fx:id="listaDivisores" prefWidth="150.0" prefHeight="200.0" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
